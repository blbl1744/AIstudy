# AI 学习专注度分析系统 —— 环境变量示例
# 用法：
#   1) 本地开发：复制为 .env 后按需修改（严禁把 .env 提交到 Git）；
#   2) 容器部署：通过 -e / --env-file 注入，不要把 .env 打进镜像。
# 说明：命名与 README「环境变量配置表」逐项一致，共 9 项（★ 为必须显式配置的生产项）。

# ★ JWT 签名密钥：长度必须 >= 32 位。未设置或过弱时程序会自动生成随机值并告警，
#   但随机值在重启/多副本之间不一致，会导致令牌全部失效，生产必须显式固定。
AI_STUDY_JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars

# ★ CORS 白名单：多个来源用英文逗号分隔；生产禁止使用 *（含通配符时会自动关闭凭证携带）。
AI_STUDY_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173

# 旧教师端管理员初始密码：M1-A 起双角色已剥离，该项不再生效。
AI_STUDY_ADMIN_PASSWORD=

# 是否启用已训练的专注度模型：1=启用（需模型文件与校验和同时就绪），0=纯规则引擎。
# 默认 0，即纯规则引擎模式，无需模型文件即可运行。
AI_STUDY_ENABLE_MODEL=0

# 模型文件路径（启用模型时生效）。
AI_STUDY_MODEL_PATH=trained_model.pkl

# 模型文件 SHA256 校验和（启用模型时的完整性校验，留空则跳过校验）。
AI_STUDY_MODEL_SHA256=

# 调试接口开关：1=注册 /api/debug/* 诊断接口（仅教师可用），其余取值一律不注册。
# 生产环境必须保持 0/留空。
AI_STUDY_DEBUG_API=0

# SQLite 数据库文件路径：容器部署建议指向挂载卷（如 /data/ai_study_buddy.db），
# 留空则回落到项目根目录下的 ai_study_buddy.db。
AI_STUDY_DB=ai_study_buddy.db

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL，非法取值自动回落 INFO。
AI_STUDY_LOG_LEVEL=INFO

# 持续分心自动预警：连续分心（未检测到人体或专注度低于 60）累计达到该秒数即触发一次温和提醒。
# 默认 15 秒；调大可减少打扰，调小则更早干预。
AI_STUDY_AUTO_ALERT_SECONDS=15

# 自动提醒冷却时间：同一学生两次自动提醒之间的最小间隔秒数，防止连续刷屏。
# 默认 60 秒；冷却期内即使持续分心也不会重复下发。
AI_STUDY_AUTO_ALERT_COOLDOWN=60
